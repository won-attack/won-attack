# Copy to .env; never commit actual keys. Local execution only (no Docker).
# Run Spring/Python commands from backend/won-check-backend.
# Use KEY=value without quotes or export; use forward slashes in paths.

# ---------- OpenAI (team settings) ----------
OPENAI_API_KEY=
# Use the same embedding model for ingestion and search.
EMBEDDING_MODEL=text-embedding-3-small

# ---------- OpenDART (data/tools/fetch_dart.py) ----------
OPENDART_API_KEY=

# ---------- ChromaDB ----------
# Relative to the repository root for the Python scripts.
CHROMA_PATH=./data/chroma_db
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=disclosures
SEARCH_TOP_K=3

# ---------- Spring Boot ----------
# This backend imports .env from its working directory automatically.
WONCHECK_MODE=mock
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---------- AI services ----------
# Reserved for chat/report generation; not implemented by this embedding change.
LLM_PROVIDER=
# Used by both Python and Spring embeddings: openai or ollama.
EMBEDDING_PROVIDER=openai

# ---------- Local Ollama ----------
OLLAMA_BASE_URL=http://localhost:11434/v1
# Reserved for chat/report generation.
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# ---------- Backend-local settings ----------
PORT=8081
WONCHECK_DATA_PATH=../../data
WONCHECK_INGEST_ENABLED=false
WONCHECK_ALLOW_SAMPLE_FALLBACK=false
