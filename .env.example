# 복사해서 .env 로 만들고 값을 채우세요. .env 는 커밋하지 않습니다.

# ---------- OpenAI (운영매니저에게 받은 팀 키) ----------
OPENAI_API_KEY=
# 주장 추출·검증·개인화에 쓸 모델 (팀에서 확정 후 기입)
LLM_MODEL=
# 저장·검색에 반드시 같은 모델 사용 (팀 확정안 3장)
EMBEDDING_MODEL=text-embedding-3-small

# ---------- OpenDART (공식 공시 수집: data/tools/fetch_dart.py) ----------
OPENDART_API_KEY=

# ---------- 벡터 DB ----------
CHROMA_PATH=./data/chroma_db
CHROMA_COLLECTION=disclosures
SEARCH_TOP_K=3

# ---------- 시연 데이터 ----------
DATA_DIR=./data

# ---------- 서버 / 프론트 ----------
BACKEND_PORT=8000
VITE_API_BASE_URL=http://localhost:8000


# ---------- 실행 모드 ----------
WONCHECK_MODE=mock

# ---------- AI 서비스 선택 ----------
# openai 또는 ollama
LLM_PROVIDER=ollama

# ---------- Ollama ----------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=
