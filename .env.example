# 복사해서 .env 로 만들고 값을 채우세요. .env 는 커밋하지 않습니다.
# 로컬 실행 전용 (배포·Docker 없음)

# ---------- AI 모델 선택 (가장 먼저 정하기) ----------
#   시연용 : LLM_PROVIDER=openai  → 대화·임베딩 모두 OpenAI (아래 OPENAI_API_KEY 필요, 빠르고 정확)
#   테스트용: LLM_PROVIDER=ollama  → 대화·임베딩 모두 PC 안의 Ollama (키 불필요, 느림)
# start-demo 실행 파일은 이 값에 맞춰 EMBEDDING_PROVIDER 도 자동으로 같은 값으로 바꾸고,
# ollama 일 때만 Ollama 설치·서버 켜기·모델 내려받기를 합니다.
LLM_PROVIDER=ollama

# ---------- OpenAI (팀 키, LLM_PROVIDER=openai 일 때) ----------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# 저장·검색에 반드시 같은 임베딩 모델 사용
EMBEDDING_MODEL=text-embedding-3-small
# 직접 실행(start-demo 미사용) 때만 의미 있음: LLM_PROVIDER 와 같은 값으로
EMBEDDING_PROVIDER=ollama

# ---------- OpenDART (공식 공시 수집: data/tools/fetch_dart.py) ----------
OPENDART_API_KEY=

# ---------- ChromaDB (로컬 서버: chroma run --path data/chroma_db --port 8000) ----------
CHROMA_PATH=./data/chroma_db
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=disclosures
SEARCH_TOP_K=3

# ---------- 백엔드 (Spring Boot, :8080) ----------
# Spring Boot는 이 파일을 자동으로 읽지 않습니다. 실행 설정의 환경 변수로 넣으세요(backend/README.md).
WONCHECK_MODE=live


# ---------- Ollama (LLM_PROVIDER=ollama 일 때) ----------
OLLAMA_BASE_URL=http://localhost:11434/v1
# 대화 모델 (약 2.5GB, 팀 테스트 기준). 다른 모델을 쓰려면 이름만 바꾸면 실행 파일이 내려받습니다
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
# 임베딩 모델 (약 600MB). 바꾸면 start-demo reset 으로 근거 DB 를 다시 적재하세요
OLLAMA_EMBEDDING_MODEL=embeddinggemma
