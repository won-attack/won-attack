# 복사해서 .env 로 만들고 값을 채우세요. .env 는 커밋하지 않습니다.
# 로컬 실행 전용 (배포·Docker 없음)

# ---------- OpenAI (팀 키) ----------
OPENAI_API_KEY=
# 저장·검색에 반드시 같은 임베딩 모델 사용
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ---------- OpenDART (공식 공시 수집: data/tools/fetch_dart.py) ----------
OPENDART_API_KEY=

# ---------- ChromaDB (로컬 서버: chroma run --path data/chroma_db --port 8000) ----------
CHROMA_PATH=./data/chroma_db
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=disclosures
SEARCH_TOP_K=3

# ---------- 백엔드 (Spring Boot, :8080) ----------
# Spring Boot는 이 파일을 자동으로 읽지 않습니다. 실행 설정의 환경 변수로 넣으세요(backend/README.md).
WONCHECK_MODE=live
OPENAI_CHAT_MODEL=gpt-4o-mini


# ---------- AI 서비스 선택 ----------
# 대화 모델만 선택: openai 또는 ollama (임베딩은 EMBEDDING_PROVIDER로 별도 선택)
# 기본은 ollama(로컬 LLM). start-demo 실행 파일이 Ollama 설치·서버 켜기·모델 내려받기까지 합니다.
# OpenAI GPT로 바꾸려면 openai 로 (임베딩은 어느 쪽이든 OpenAI를 쓰므로 OPENAI_API_KEY는 항상 필요)
LLM_PROVIDER=ollama

# ---------- Ollama ----------
OLLAMA_BASE_URL=http://localhost:11434/v1
# 대화 모델 (약 2.5GB, 팀 테스트 기준). 다른 모델을 쓰려면 이름만 바꾸면 실행 파일이 내려받습니다
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBEDDING_MODEL=
